<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{blog.title}}</title>
	{{#if blog.description}}
	<meta name="description" content="{{blog.description}}">
	{{/if}}
	<style>
		*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

		body {
			font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
			line-height: 1.7;
			color: #1a1a1a;
			background: #fff;
		}

		.container {
			max-width: 680px;
			margin: 0 auto;
			padding: 0 1.5rem;
		}

		header {
			padding: 3rem 0 2rem;
			border-bottom: 1px solid #eee;
			margin-bottom: 2.5rem;
		}

		header h1 {
			font-size: 1.75rem;
			font-weight: 700;
			letter-spacing: -0.02em;
		}

		header h1 a {
			color: inherit;
			text-decoration: none;
		}

		header p {
			margin-top: 0.5rem;
			color: #666;
			font-size: 1rem;
		}

		.post-list { list-style: none; }

		.post-item {
			padding: 1.75rem 0;
			border-bottom: 1px solid #f0f0f0;
		}

		.post-item:last-child { border-bottom: none; }

		.post-item h2 {
			font-size: 1.25rem;
			font-weight: 600;
			line-height: 1.4;
			margin-bottom: 0.35rem;
		}

		.post-item h2 a {
			color: inherit;
			text-decoration: none;
		}

		.post-item h2 a:hover { text-decoration: underline; }

		.post-meta {
			font-size: 0.875rem;
			color: #999;
			margin-bottom: 0.5rem;
		}

		.post-excerpt {
			color: #555;
			font-size: 0.95rem;
		}

		.post-article {
			padding: 2rem 0;
		}

		.post-article h1 {
			font-size: 2rem;
			font-weight: 700;
			line-height: 1.3;
			letter-spacing: -0.02em;
			margin-bottom: 0.5rem;
		}

		.post-article .post-meta { margin-bottom: 2rem; }

		.post-article .post-content {
			font-size: 1.05rem;
			line-height: 1.8;
		}

		.post-article .post-content p { margin-bottom: 1.25rem; }

		.post-article .post-content h2,
		.post-article .post-content h3 {
			margin-top: 2rem;
			margin-bottom: 0.75rem;
		}

		.post-article .post-content img {
			max-width: 100%;
			height: auto;
			border-radius: 4px;
		}

		.post-article .post-content a {
			color: #0066cc;
			text-decoration: underline;
		}

		.post-article .post-content blockquote {
			border-left: 3px solid #ddd;
			padding-left: 1rem;
			color: #555;
			margin: 1.5rem 0;
		}

		.post-article .post-content code {
			background: #f5f5f5;
			padding: 0.15em 0.4em;
			border-radius: 3px;
			font-size: 0.9em;
		}

		.post-article .post-content pre {
			background: #f5f5f5;
			padding: 1rem;
			border-radius: 4px;
			overflow-x: auto;
			margin: 1.5rem 0;
		}

		.post-article .post-content pre code {
			background: none;
			padding: 0;
		}

		.back-link {
			display: inline-block;
			margin-top: 2rem;
			color: #666;
			text-decoration: none;
			font-size: 0.9rem;
		}

		.back-link:hover { color: #1a1a1a; }

		footer {
			margin-top: 3rem;
			padding: 2rem 0;
			border-top: 1px solid #eee;
			text-align: center;
			font-size: 0.85rem;
			color: #999;
		}

		@media (max-width: 600px) {
			header { padding: 2rem 0 1.5rem; }
			.post-article h1 { font-size: 1.5rem; }
		}
	</style>
</head>
<body>
	<div class="container">
		{{> header}}

		{{#if post}}
			<article class="post-article">
				<h1>{{post.title}}</h1>
				<div class="post-meta">
					<time>{{formatDate post.created}}</time>
					{{#if post.author}}
						&middot; {{post.author.name}} {{post.author.lastname}}
					{{/if}}
				</div>
				<div class="post-content">{{{post.content}}}</div>
			</article>
			<a class="back-link" href="/">&larr; Volver al inicio</a>
		{{else}}
			{{#if category}}
				<h2 style="margin-bottom:1.5rem;color:#666;font-size:1.1rem;">
					Categoría: {{category.name}}
				</h2>
			{{/if}}
			<ul class="post-list">
				{{#each posts}}
					<li class="post-item">
						<h2><a href="/{{this.slug}}">{{this.title}}</a></h2>
						<div class="post-meta">
							<time>{{formatDate this.created}}</time>
							{{#if this.author}}
								&middot; {{this.author.name}} {{this.author.lastname}}
							{{/if}}
						</div>
						{{#if this.description}}
							<p class="post-excerpt">{{truncate this.description 200}}</p>
						{{/if}}
					</li>
				{{else}}
					<li style="padding:2rem 0;color:#999;">No hay publicaciones todavía.</li>
				{{/each}}
			</ul>
		{{/if}}

		{{> footer}}
	</div>
</body>
</html>

