<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{blog.title}}</title>
  {{#if blog.description}}
  <meta name="description" content="{{blog.description}}">
  {{/if}}
  <link href="{{cdnAsset 'img/favicon.ico'}}" rel="icon">
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:300;400;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
  <link href="{{cdnAsset 'css/style.css'}}" rel="stylesheet">
</head>
<body>
  <div class="wrapper">
    <!-- Sidebar -->
    <div class="sidebar">
      <div class="sidebar-text d-flex flex-column h-100 justify-content-center text-center">
        {{#if blog.thumbnail}}
        <img class="mx-auto d-block w-75 bg-primary img-fluid rounded-circle mb-4 p-3" src="{{blog.thumbnail}}" alt="{{blog.title}}">
        {{/if}}
        <h1 class="font-weight-bold">{{blog.title}}</h1>
        {{#if blog.description}}
        <p class="mb-4">{{blog.description}}</p>
        {{/if}}
        <div class="d-flex justify-content-center mb-5">
          <a class="btn btn-outline-primary mr-2" href="#"><i class="fab fa-twitter"></i></a>
          <a class="btn btn-outline-primary mr-2" href="#"><i class="fab fa-facebook-f"></i></a>
          <a class="btn btn-outline-primary mr-2" href="#"><i class="fab fa-linkedin-in"></i></a>
          <a class="btn btn-outline-primary mr-2" href="#"><i class="fab fa-instagram"></i></a>
        </div>
      </div>
      <div class="sidebar-icon d-flex flex-column h-100 justify-content-center text-right">
        <i class="fas fa-2x fa-angle-double-right text-primary"></i>
      </div>
    </div>

    <!-- Content -->
    <div class="content">
      <!-- Navbar -->
      <div class="container p-0">
        <nav class="navbar navbar-expand-lg bg-secondary navbar-dark">
          <a href="" class="navbar-brand d-block d-lg-none">Navigation</a>
          <button type="button" class="navbar-toggler" data-toggle="collapse" data-target="#navbarCollapse">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse justify-content-between" id="navbarCollapse">
            <div class="navbar-nav m-auto">
              <a href="/" class="nav-item nav-link active">Home</a>
            </div>
          </div>
        </nav>
      </div>

      {{#if post}}
      <!-- Single Post View -->
      <div class="container py-5 px-2 bg-white">
        <div class="row px-4">
          <div class="col-12">
            {{#if post.thumbnail}}
            <img class="img-fluid mb-4" src="{{post.thumbnail}}" alt="{{post.title}}">
            {{/if}}
            <h2 class="mb-3 font-weight-bold">{{post.title}}</h2>
            <div class="d-flex">
              <p class="mr-3 text-muted"><i class="fa fa-calendar-alt"></i> {{formatDate post.created}}</p>
              {{#if post.category}}
              <p class="mr-3 text-muted"><i class="fa fa-folder"></i> {{post.category.name}}</p>
              {{/if}}
            </div>
            <div class="post-content">{{{post.content}}}</div>
          </div>
          {{#if post.tags.length}}
          <div class="col-12 py-4">
            {{#each post.tags}}
            <a href="" class="btn btn-sm btn-outline-primary mb-1">{{this}}</a>
            {{/each}}
          </div>
          {{/if}}
        </div>
      </div>

      <!-- Comments (commented out for future implementation) -->
      <!--
      <div class="container py-5 px-2 bg-light">
        <div class="row px-4">
          <div class="col-12">
            <h3 class="mb-4 font-weight-bold">Comments</h3>
            <div id="comments-list">
              <p class="text-muted">No comments yet. Be the first to comment!</p>
            </div>
            <form id="comment-form" class="mt-4">
              <div class="form-group">
                <input type="text" class="form-control" placeholder="Your Name" required>
              </div>
              <div class="form-group">
                <input type="email" class="form-control" placeholder="Your Email" required>
              </div>
              <div class="form-group">
                <textarea class="form-control" rows="4" placeholder="Your Comment" required></textarea>
              </div>
              <button type="submit" class="btn btn-primary">Post Comment</button>
            </form>
          </div>
        </div>
      </div>
      -->

      {{else}}
      <!-- Home / Category Listing View -->

      {{#if category}}
      <div class="container py-5 px-2 bg-primary">
        <div class="row py-5 px-4">
          <div class="col-sm-6 text-center text-md-left">
            <h1 class="mb-3 mb-md-0 text-white text-uppercase font-weight-bold">Categoría: {{category.name}}</h1>
          </div>
        </div>
      </div>
      {{/if}}

      {{#unless category}}
      <!-- Carousel (home only) -->
      {{#if posts.length}}
      <div class="container p-0">
        <div id="blog-carousel" class="carousel slide" data-ride="carousel">
          <div class="carousel-inner">
            {{#each posts}}
            {{#ifEquals @index 0}}
            <div class="carousel-item active">
              {{#if this.thumbnail}}
              <img class="w-100" src="{{this.thumbnail}}" alt="{{this.title}}">
              {{/if}}
              <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                <h2 class="mb-3 text-white font-weight-bold">{{this.title}}</h2>
                <div class="d-flex text-white">
                  <small class="mr-2"><i class="fa fa-calendar-alt"></i> {{formatDate this.created}}</small>
                  {{#if this.category}}
                  <small class="mr-2"><i class="fa fa-folder"></i> {{this.category.name}}</small>
                  {{/if}}
                </div>
                <a href="/{{this.slug}}" class="btn btn-lg btn-outline-light mt-4">Read More</a>
              </div>
            </div>
            {{else}}
            {{#ifEquals @index 1}}
            <div class="carousel-item">
              {{#if this.thumbnail}}
              <img class="w-100" src="{{this.thumbnail}}" alt="{{this.title}}">
              {{/if}}
              <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                <h2 class="mb-3 text-white font-weight-bold">{{this.title}}</h2>
                <div class="d-flex text-white">
                  <small class="mr-2"><i class="fa fa-calendar-alt"></i> {{formatDate this.created}}</small>
                  {{#if this.category}}
                  <small class="mr-2"><i class="fa fa-folder"></i> {{this.category.name}}</small>
                  {{/if}}
                </div>
                <a href="/{{this.slug}}" class="btn btn-lg btn-outline-light mt-4">Read More</a>
              </div>
            </div>
            {{else}}
            {{#ifEquals @index 2}}
            <div class="carousel-item">
              {{#if this.thumbnail}}
              <img class="w-100" src="{{this.thumbnail}}" alt="{{this.title}}">
              {{/if}}
              <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                <h2 class="mb-3 text-white font-weight-bold">{{this.title}}</h2>
                <div class="d-flex text-white">
                  <small class="mr-2"><i class="fa fa-calendar-alt"></i> {{formatDate this.created}}</small>
                  {{#if this.category}}
                  <small class="mr-2"><i class="fa fa-folder"></i> {{this.category.name}}</small>
                  {{/if}}
                </div>
                <a href="/{{this.slug}}" class="btn btn-lg btn-outline-light mt-4">Read More</a>
              </div>
            </div>
            {{/ifEquals}}
            {{/ifEquals}}
            {{/ifEquals}}
            {{/each}}
          </div>
          <a class="carousel-control-prev" href="#blog-carousel" data-slide="prev">
            <span class="carousel-control-prev-icon"></span>
          </a>
          <a class="carousel-control-next" href="#blog-carousel" data-slide="next">
            <span class="carousel-control-next-icon"></span>
          </a>
        </div>
      </div>
      {{/if}}
      {{/unless}}

      <!-- Blog List -->
      <div class="container bg-white pt-5">
        {{#each posts}}
        <div class="row blog-item px-3 pb-5">
          <div class="col-md-5">
            {{#if this.thumbnail}}
            <img class="img-fluid mb-4 mb-md-0" src="{{this.thumbnail}}" alt="{{this.title}}">
            {{/if}}
          </div>
          <div class="col-md-7">
            <h3 class="mt-md-4 px-md-3 mb-2 py-2 bg-white font-weight-bold">{{this.title}}</h3>
            <div class="d-flex mb-3">
              <small class="mr-2 text-muted"><i class="fa fa-calendar-alt"></i> {{formatDate this.created}}</small>
              {{#if this.category}}
              <small class="mr-2 text-muted"><i class="fa fa-folder"></i> {{this.category.name}}</small>
              {{/if}}
            </div>
            {{#if this.description}}
            <p>{{truncate this.description 200}}</p>
            {{/if}}
            <a class="btn btn-link p-0" href="/{{this.slug}}">Read More <i class="fa fa-angle-right"></i></a>
          </div>
        </div>
        {{/each}}
      </div>

      <!-- Subscribe (commented out for future implementation) -->
      <!--
      <div class="container py-5 px-4 bg-secondary text-center">
        <h1 class="text-white font-weight-bold">Subscribe My Newsletter</h1>
        <p class="text-white">Subscribe and get my latest article in your inbox</p>
        <form class="form-inline justify-content-center">
          <div class="input-group">
            <input type="text" class="form-control" placeholder="Your Email">
            <div class="input-group-append">
              <button class="btn btn-primary" type="submit">Subscribe</button>
            </div>
          </div>
        </form>
      </div>
      -->

      <!-- Pagination -->
      {{#if pagination}}
      {{#if pagination.totalPages}}
      {{#unless (ifEquals pagination.totalPages 1)}}
      <div class="container bg-white pt-5">
        <div class="row px-3 pb-5">
          <nav aria-label="Page navigation">
            <ul class="pagination m-0 mx-3">
              {{#ifEquals pagination.page 1}}
              <li class="page-item disabled">
              {{else}}
              <li class="page-item">
              {{/ifEquals}}
                <a class="page-link" href="?page={{math pagination.page -1}}" aria-label="Previous">
                  <span aria-hidden="true">&laquo;</span>
                </a>
              </li>
              {{#each (range 1 pagination.totalPages)}}
              {{#ifEquals this ../pagination.page}}
              <li class="page-item active"><a class="page-link" href="?page={{this}}">{{this}}</a></li>
              {{else}}
              <li class="page-item"><a class="page-link" href="?page={{this}}">{{this}}</a></li>
              {{/ifEquals}}
              {{/each}}
              {{#ifEquals pagination.page pagination.totalPages}}
              <li class="page-item disabled">
              {{else}}
              <li class="page-item">
              {{/ifEquals}}
                <a class="page-link" href="?page={{math pagination.page 1}}" aria-label="Next">
                  <span aria-hidden="true">&raquo;</span>
                </a>
              </li>
            </ul>
          </nav>
        </div>
      </div>
      {{/unless}}
      {{/if}}
      {{/if}}

      {{/if}}

      <!-- Footer -->
      <div class="container py-4 bg-secondary text-center">
        <p class="m-0 text-white">
          &copy; <a class="text-white font-weight-bold" href="#">{{blog.title}}</a>. All Rights Reserved. Powered by <a class="text-white font-weight-bold" href="https://lettercms.com">LetterCMS</a>
        </p>
      </div>
    </div>
  </div>

  <!-- Back to Top -->
  <a href="#" class="back-to-top"><i class="fa fa-angle-double-up"></i></a>

  <!-- JavaScript Libraries -->
  <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.bundle.min.js"></script>
  <script>
    $(window).scroll(function () {
      if ($(this).scrollTop() > 100) { $(".back-to-top").fadeIn("slow"); }
      else { $(".back-to-top").fadeOut("slow"); }
    });
    $(".back-to-top").click(function () {
      $("html, body").animate({ scrollTop: 0 }, 1500);
      return false;
    });
  </script>
</body>
</html>
